    {
      "parameters": {
        "jsCode": "// Gera lista de feeds a partir do CFG\nconst cfg = $('CFG - Config').first().json;\nconst feeds = cfg.rssFeeds.split(',').map(f => f.trim()).filter(Boolean);\n\nreturn feeds.map(url => ({ json: { feedUrl: url, maxItems: cfg.maxItemsPerFeed } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "7185ce14-ca13-43ce-ba8d-483c4224908c",
      "name": "FN | Listar Feeds"
    },
    {
      "parameters": {
        "url": "={{ $json.feedUrl }}",
        "options": {}
      },
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "id": "cea36608-0924-4698-95f6-1515de2b8d30",
      "name": "HTTP | Ler RSS",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Agregar e limitar notícias\nconst allItems = $input.all();\nconst maxPerFeed = 5;\n\n// Pega título + link + content resumido\nconst news = allItems\n  .filter(item => item.json.title && !item.json.error)\n  .slice(0, 15)\n  .map(item => ({\n    titulo: item.json.title || '',\n    link: item.json.link || '',\n    fonte: item.json.creator || item.json['dc:creator'] || 'N/A',\n    resumo: (item.json.contentSnippet || item.json.content || '').replace(/<[^>]*>/g, '').substring(0, 200)\n  }));\n\nif (news.length === 0) {\n  return [{ json: { skip: true, reason: 'Nenhuma notícia encontrada' } }];\n}\n\nconst textBlock = news.map((n, i) => \n  `${i+1}. ${n.titulo}\\nFonte: ${n.fonte}\\n${n.resumo}...\\n${n.link}`\n).join('\\n\\n');\n\nreturn [{ json: { newsBlock: textBlock, totalNews: news.length, skip: false } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "1a93378c-45e9-4040-b191-1ae4282f117c",
      "name": "FN | Agregar Notícias"
    },
