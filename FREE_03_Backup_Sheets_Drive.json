      "name": "CFG - Config"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.sheetName }}",
          "mode": "name"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "id": "03079ca4-47d1-418a-b3dc-052eece7fabe",
      "name": "DB | Ler Planilha",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "__CREDENTIAL_ID__",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Converter dados da planilha em CSV\nconst items = $input.all();\nif (!items.length) {\n  return [{ json: { skip: true, reason: 'Planilha vazia' } }];\n}\n\nconst cfg = $('CFG - Config').first().json;\n\n// Headers\nconst headers = Object.keys(items[0].json);\nconst csvLines = [headers.join(',')];\n\n// Rows\nfor (const item of items) {\n  const row = headers.map(h => {\n    const val = String(item.json[h] || '').replace(/\"/g, '\"\"');\n    return `\"${val}\"`;\n  });\n  csvLines.push(row.join(','));\n}\n\nconst csv = csvLines.join('\\n');\nconst now = new Date();\nconst dateStr = now.toISOString().split('T')[0];\nconst fileName = `backup_${cfg.sheetName}_${dateStr}.csv`;\n\nreturn [{\n  json: {\n    fileName,\n    totalRows: items.length,\n    folderId: cfg.backupFolderId,\n    skip: false\n  },\n  binary: {\n    data: {\n      data: Buffer.from(csv, 'utf-8').toString('base64'),\n      mimeType: 'text/csv',\n      fileName\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "0d4c43cb-918f-4ebb-a7cf-e242983069e4",
      "name": "FN | Converter p/ CSV"
    },
    {
      "parameters": {
        "name": "={{ $json.fileName }}",
        "folderId": {
          "__rl": true,
          "value": "={{ $json.folderId }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "id": "871dddd4-e7ca-43b2-8b31-6b6f294c6197",
      "name": "DB | Upload → Google Drive",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "__CREDENTIAL_ID__",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('CFG - Config').item.json.chatIdTelegram }}",
        "text": "=✅ *Backup concluído!*\n\n📄 {{ $('FN | Converter p/ CSV').item.json.fileName }}\n📊 {{ $('FN | Converter p/ CSV').item.json.totalRows }} linhas\n📁 Salvo no Google Drive\n⏰ {{ new Date().toLocaleString('pt-BR') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
